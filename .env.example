# Telegram Bot (создать через @BotFather)
BOT_TOKEN=
# GATEWAY_MODE=poll   # по умолчанию, без HTTPS
# GATEWAY_MODE=webhook  # нужен HTTPS + setWebhook

# Redis (по умолчанию redis://localhost:6379/0)
REDIS_URL=redis://localhost:6379/0

# PostgreSQL с pgvector (граф + RAG)
DATABASE_URL=postgresql://mindmap:mindmap@localhost:5432/mindmap

# Провайдер ИИ: qwen (по умолчанию) | openai
LLM_PROVIDER=qwen

# Qwen (DashScope) — для LLM_PROVIDER=qwen
QWEN_API_KEY=
# или DASHSCOPE_API_KEY (альтернатива)
# DASHSCOPE_BASE_URL по умолчанию Singapore; для China: https://dashscope.aliyuncs.com/compatible-mode/v1
# Модель чата (по умолчанию qwen-plus; опция: qwen-max, qwen-turbo)
# QWEN_CHAT_MODEL=qwen-plus

# OpenAI — для LLM_PROVIDER=openai
OPENAI_API_KEY=

# Для webhook: публичный URL Gateway (например ngrok)
# WEBHOOK_BASE_URL=https://your-domain.com

# MCP Brave Search API (https://brave.com/search/api/ — бесплатно 2000 запросов/месяц)
BRAVE_API_KEY=

# Planner: multistep — цепочка tools (найди и сохрани)
# USE_MULTISTEP_PLANNER=true

# Режим отладки: план запросов на каждом шаге отправляется в Telegram
# USE_DEBUG=true
